    <string name="perm_wifi_action">打开 Wi-Fi 设置</string>
    <string name="perm_dev_title">打开开发者选项</string>
    <string name="perm_dev_1">点下面的按钮。</string>
    <string name="perm_dev_2">找到“版本号”（有的手机在“软件信息”里面），连点 7 下。</string>
    <string name="perm_dev_3">看到“已处于开发者模式”后，按返回键回到这里。</string>
    <string name="perm_wireless_title">打开“无线调试”</string>
    <string name="perm_wireless_1">点下面的按钮，往下找到“无线调试”。</string>
    <string name="perm_wireless_2">打开它右边的开关。</string>
    <string name="perm_wireless_3">弹出询问时，勾上“始终允许使用此网络”，点“允许”。然后回到这里。</string>
    <string name="perm_wireless_action">打开开发者选项</string>
    <string name="perm_pair_title">配对</string>
    <string name="perm_pair_1">点下面的按钮，然后点“无线调试”这几个字（点字，不是点开关）。</string>
    <string name="perm_pair_2">点“使用配对码配对设备”，屏幕上会出现 6 位数字。</string>
    <string name="perm_pair_3">不要离开那个页面。屏幕顶部会弹出一条 Miu Bridge 的通知，点它上面的“输入配对码”。</string>
    <string name="perm_pair_4">把那 6 位数字填进去，发送。通知不见了的话，从屏幕顶部往下拉就能找到。</string>
